{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12
  },
  "globals": {
    "getOrCreateStyleElement": "readonly",
    "markActiveNavLink": "readonly",
    "showToast": "readonly",
    "waitForReflow": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-extra-semi": "warn",
    "eqeqeq": "warn"
  }
}
